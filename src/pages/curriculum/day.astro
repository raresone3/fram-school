---
import Layout from '~/components/Layout.astro';
import CtaBand from '~/components/CtaBand.astro';

interface Stop {
  time: string;
  title: string;
  subtitle: string;
  desc: string;
  image: string;
  alt: string;
}

const stops: Stop[] = [
  {
    time: '8:30',
    title: 'Arrival',
    subtitle: 'The day begins at the gate.',
    desc: 'Children are welcomed at the front gate by their class teacher, signed in by a parent, and walked into the courtyard. Drop-off runs from 8:00 to 8:20. The day starts with a calm settle and a circle, not a bell.',
    image: '/images/events/assembly-attendance.jpg',
    alt: 'FRAM children at a morning gathering in the courtyard',
  },
  {
    time: '9:00',
    title: 'First lessons',
    subtitle: 'English, mathematics, science, in mixed-ability classes.',
    desc: 'The Cambridge Primary curriculum, taught in English by qualified subject and class teachers. Class sizes stay small. Mixed-ability is the default, we differentiate within the classroom rather than streaming early.',
    image: '/images/events/reading-day-1.jpg',
    alt: 'A FRAM lesson at the interactive whiteboard',
  },
  {
    time: '11:00',
    title: 'Morning break',
    subtitle: 'Outside, in the playground.',
    desc: 'Twenty minutes outside in the courtyard, snack from home or fruit provided by school. Children run, regroup, find their friends. Teachers supervise and breathe with them.',
    image: '/images/houses-photos/joy.jpg',
    alt: 'FRAM children outside at a school activity',
  },
  {
    time: '11:30',
    title: 'Romanian, French, the arts',
    subtitle: 'Subject specialists take over.',
    desc: 'Children move between specialists for Romanian language and literature, French, drama, music and art. The Romanian line and the international line run alongside each other every week.',
    image: '/images/events/reading-day-2.jpg',
    alt: 'A FRAM lesson on the classroom screen',
  },
  {
    time: '12:30',
    title: 'Lunch',
    subtitle: 'Hot, included, eaten with teachers.',
    desc: 'Lunch is hot, included in the fee, and eaten together in the cafeteria. Teachers are seated at every table, not in a separate room. Conversation, manners, and "tell me about your morning" all happen here.',
    image: '/images/campus/classroom-2.jpg',
    alt: 'A FRAM classroom interior',
  },
  {
    time: '13:15',
    title: 'Afternoon learning',
    subtitle: 'Project work, P4C, library, PE.',
    desc: 'The afternoons rotate: project work, science investigations, Philosophy for Children with Tiberiu Moldovanu, library and reading time, PE in the courtyard or the gym. The pace softens, the depth grows.',
    image: '/images/events/reading-day-3.jpg',
    alt: 'A FRAM afternoon lesson at the interactive screen',
  },
  {
    time: '15:15',
    title: 'School day ends',
    subtitle: 'The mandatory day finishes.',
    desc: 'The Cambridge school day finishes at 3:15. Pick-up window runs from 4:15 to 4:30 for children leaving immediately. Children authorised on the emergency form can be collected; everyone else stays on for Houses and Clubs.',
    image: '/images/houses-photos/sitting-attentive.jpg',
    alt: 'A FRAM lesson in the late afternoon',
  },
  {
    time: '15:30 → 16:15',
    title: 'Houses & Clubs',
    subtitle: 'The Yellow Pillar, four afternoons a week.',
    desc: 'Children stay on for the school House programme and extracurricular Clubs, both included in fees. Bike Club, art, drama, sport, House activities. The school is at its best between 3:30 and 4:15.',
    image: '/images/houses-photos/dog.jpg',
    alt: 'A whole-school gathering at Habermann Campus',
  },
];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://framschool.com/' },
    { '@type': 'ListItem', position: 2, name: 'Curriculum', item: 'https://framschool.com/curriculum' },
    { '@type': 'ListItem', position: 3, name: 'A day at FRAM', item: 'https://framschool.com/curriculum/day' },
  ],
};
---

<Layout
  title="A day at FRAM"
  description="The FRAM school day, hour by hour: from arrival at 8:30 to Houses and Clubs ending at 4:15. Scroll through the day."
  current="/curriculum/day"
  schema={breadcrumb}
>
  {/* ──────── Header ──────── */}
  <header class="day-head container">
    <p class="eyebrow">A day at FRAM</p>
    <h1 class="day-head__title"><em>A Tuesday,</em> hour by hour.</h1>
    <p class="day-head__lead">
      Most schools say what they teach. Few say what a day actually looks like. Scroll through ours, from arrival at 8:30 to Houses and Clubs at 4:15.
    </p>
  </header>

  {/* ──────── Sticky day-rail with bear ──────── */}
  <div class="day-rail" aria-hidden="true">
    <div class="day-rail__inner container">
      <span class="day-rail__from">8:30</span>
      <div class="day-rail__track">
        <span class="day-rail__bear">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
            <path d="M6.5 8a3 3 0 1 1 1.7-5.5A6.5 6.5 0 0 1 12 2c1.4 0 2.7.4 3.8 1.1a3 3 0 1 1 1.6 5.5c.4.7.6 1.5.6 2.4 0 3-2.7 5.5-6 5.5s-6-2.5-6-5.5c0-.9.2-1.7.5-2.5Z M9 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z M15 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z M11 11h2v1.4a1 1 0 0 1-2 0V11Z M8 17 c2 1 6 1 8 0 v3 a1 1 0 0 1-1 1 H9 a1 1 0 0 1-1-1 v-3Z"/>
          </svg>
        </span>
      </div>
      <span class="day-rail__to">16:15</span>
    </div>
  </div>

  {/* ──────── The day, scene by scene ──────── */}
  <article class="cinema">
    <ol class="cinema__list">
      {stops.map((stop, i) => (
        <li class={`cinema__stop ${i % 2 === 0 ? 'is-left' : 'is-right'}`} id={`stop-${i + 1}`} data-stop={i + 1}>
          <figure class="cinema__photo">
            <img
              src={stop.image}
              alt={stop.alt}
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={i === 0 ? 'high' : undefined}
            />
            <figcaption class="cinema__time">{stop.time}</figcaption>
          </figure>
          <div class="cinema__copy">
            <p class="cinema__index">{String(i + 1).padStart(2, '0')} <span aria-hidden="true">/</span> <span class="muted">{String(stops.length).padStart(2, '0')}</span></p>
            <h2 class="cinema__title"><em>{stop.title}.</em></h2>
            <p class="cinema__subtitle">{stop.subtitle}</p>
            <p class="cinema__desc">{stop.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </article>

  <CtaBand
    eyebrow="See it live"
    title="The school is at its best when it doesn't know it's being looked at."
    primaryCta={{ label: 'Book a tour during a school day', href: '/admissions/visit' }}
    secondaryCta={{ label: 'Read about the curriculum', href: '/curriculum' }}
  />
</Layout>

<style>
  /* ──────── Header ──────── */
  .day-head {
    padding-block: clamp(3rem, 5vw + 1.5rem, 5rem) clamp(1.5rem, 2vw + 0.75rem, 2.5rem);
  }
  .day-head .eyebrow { color: var(--brand-red); }
  .day-head__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.5rem, 1.6rem + 4vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.012em;
    margin: 0.625rem 0 1.25rem;
    max-width: 18ch;
    text-wrap: balance;
  }
  .day-head__title em {
    font-style: italic;
    color: var(--brand-red);
    font-variation-settings: 'opsz' 144, 'SOFT' 100;
  }
  .day-head__lead {
    font-size: var(--t-body-lg);
    line-height: 1.5;
    color: var(--ink);
    max-width: 56ch;
  }

  /* ──────── Sticky day rail ──────── */
  .day-rail {
    position: sticky;
    top: 4.25rem;
    z-index: 5;
    background: var(--paper);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding-block: 0.625rem;
  }
  .day-rail__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.875rem;
    align-items: center;
  }
  .day-rail__from,
  .day-rail__to {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .day-rail__track {
    height: 1px;
    background: var(--rule);
    position: relative;
  }
  .day-rail__bear {
    position: absolute;
    top: -12px;
    left: 0;
    width: 24px;
    height: 24px;
    color: var(--brand-red);
    transition: left 80ms linear;
    will-change: left;
  }

  /* ──────── Cinema (the day, scene by scene) ──────── */
  /* Scope the named timeline to the page so the sticky bear (a sibling) can read it */
  :global(body) {
    timeline-scope: --cinema-scroll;
  }
  .cinema {
    view-timeline-name: --cinema-scroll;
    view-timeline-axis: block;
    padding-block: 1rem 4rem;
  }
  .cinema__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cinema__stop {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    padding-block: clamp(2.5rem, 5vw + 1rem, 5rem);
    padding-inline: clamp(1.25rem, 2vw + 0.5rem, 2rem);
    border-bottom: 1px solid var(--rule);
    align-items: center;
    max-width: var(--container-wide);
    margin-inline: auto;
  }
  .cinema__stop:last-child { border-bottom: 0; }

  @media (min-width: 880px) {
    .cinema__stop {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2.5rem, 4vw, 4rem);
      padding-block: clamp(4rem, 8vw + 2rem, 8rem);
      padding-inline: clamp(1.5rem, 3vw + 0.5rem, 2.5rem);
      min-height: 75vh;
    }
    .cinema__stop.is-right .cinema__photo { order: 2; }
  }

  .cinema__photo {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
    position: relative;
    background: var(--paper-deep);
    will-change: transform;
  }
  .cinema__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cinema__time {
    position: absolute;
    bottom: 0.875rem;
    left: 0.875rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.25rem, 0.9rem + 1.4vw, 1.875rem);
    color: var(--paper-pure);
    background: var(--brand-red);
    padding: 0.375rem 0.875rem;
    border-radius: 2px;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.005em;
  }

  .cinema__copy {
    max-width: 50ch;
  }
  .cinema__index {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-red);
    font-variant-numeric: tabular-nums;
    margin: 0 0 0.875rem;
  }
  .cinema__index .muted { color: var(--ink-muted); font-weight: 400; }
  .cinema__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 0.875rem;
    text-wrap: balance;
  }
  .cinema__title em {
    font-style: italic;
    color: var(--brand-red);
  }
  .cinema__subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: var(--t-body-lg);
    line-height: 1.4;
    color: var(--ink);
    margin: 0 0 1.25rem;
    text-wrap: balance;
  }
  .cinema__desc {
    color: var(--ink);
    line-height: 1.65;
  }

  /* ──────── Scroll-driven enhancements ──────── */
  @supports (animation-timeline: scroll()) {
    @keyframes bear-walk {
      from { left: 0; }
      to { left: calc(100% - 24px); }
    }
    .day-rail__bear {
      animation: bear-walk linear forwards;
      animation-timeline: --cinema-scroll;
      animation-range: cover 0% cover 100%;
      transition: none;
    }

    @keyframes photo-rise {
      from { opacity: 0.55; transform: scale(1.04); }
      to { opacity: 1; transform: scale(1); }
    }
    .cinema__photo {
      animation: photo-rise linear both;
      animation-timeline: view();
      animation-range: entry 5% cover 35%;
    }

    @keyframes copy-rise {
      from { opacity: 0.4; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .cinema__copy {
      animation: copy-rise linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 40%;
    }
  }

  /* Reduced motion: collapse the cinema to a calm static timeline */
  @media (prefers-reduced-motion: reduce) {
    .cinema__stop { min-height: auto; }
    .cinema__photo,
    .cinema__copy {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .day-rail__bear { animation: none !important; }
  }
</style>

<script is:inline>
  // ──── Sticky-rail bear position fallback for browsers without scroll-driven animations ────
  (function () {
    if (typeof CSS !== 'undefined' && CSS.supports && CSS.supports('animation-timeline: scroll()')) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const bear = document.querySelector('.day-rail__bear');
    const cinema = document.querySelector('.cinema');
    if (!bear || !cinema) return;

    const update = () => {
      const rect = cinema.getBoundingClientRect();
      const vh = window.innerHeight;
      const total = rect.height + vh;
      const seen = vh - rect.top;
      const ratio = Math.max(0, Math.min(1, seen / total));
      bear.style.left = `calc(${(ratio * 100).toFixed(2)}% - ${(ratio * 24).toFixed(2)}px)`;
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  })();
</script>
