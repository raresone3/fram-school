---
import Layout from '~/components/Layout.astro';
import Button from '~/components/Button.astro';
import Stamp from '~/components/Stamp.astro';
import PillarsTeaser from '~/components/PillarsTeaser.astro';
import DayInTheLife from '~/components/DayInTheLife.astro';
import Voices from '~/components/Voices.astro';
import CtaBand from '~/components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { faq } from '~/lib/schema';

const homepageFaq = faq([
  { q: 'What ages does FRAM School teach?', a: 'FRAM School teaches children aged 3 to 11, from kindergarten (Pre-Primary) through Year 6 of primary school.' },
  { q: 'What curriculum does FRAM follow?', a: 'FRAM is a fully accredited Cambridge International School and a Romanian-recognised school. We teach the Cambridge Primary Curriculum on the English Line and the Romanian National Curriculum on the Romanian Line, with subject specialists across both languages.' },
  { q: 'Where is FRAM School located?', a: "FRAM is in central Sibiu, Romania, at the Habermann Learning Campus, Berăriei 4. Five minutes' walk from the old town." },
  { q: 'When does the school day start and end?', a: 'The mandatory programme runs Monday to Friday from 9:00 to 15:15. Houses & Clubs run from 15:30 to 16:15 (Tuesdays) and to 16:30 (Fridays). Drop-off opens at 8:00 AM.' },
  { q: 'How do I apply to FRAM?', a: "Write to admissions@framschool.com with your child's age and intended start year. The admissions process has four steps: enquiry, school visit, assessment morning, and offer." },
  { q: 'Who is the Designated Safeguarding Lead?', a: "Marieluise Knobloch is FRAM's Designated Safeguarding Lead. For any concern about a child's safety, write to safeguarding@framschool.com." },
]);

// Pull a sample of teachers and leaders for the People strip.
const allTeachers = await getCollection('teachers');
const teachers = allTeachers
  .filter((t) => t.data.portrait)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 8);
const allLeaders = await getCollection('leaders');
const leaders = allLeaders
  .filter((l) => l.data.portrait)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="FRAM School"
  description="A Cambridge primary and kindergarten in central Sibiu, Romania. Twenty teachers, two languages, seven values, four houses. For children aged 3 to 11."
  current="/"
  schema={[homepageFaq]}
>
  {/* ──────────── 1. HERO ──────────── */}
  <section class="lp-hero">
    <div class="container lp-hero__inner">
      <div class="lp-hero__text">
        <p class="eyebrow lp-hero__eyebrow">
          <Stamp size={14} />
          <span>Habermann Campus, Sibiu</span>
        </p>
        <h1 class="lp-hero__title">
          <em>What kind of school<br/>would I want<br/>for my own child?</em>
        </h1>
        <p class="lp-hero__sub">
          FRAM is a Cambridge primary and kindergarten on the Habermann Learning Campus, for children aged 3 to 11. Founded 2014.
        </p>
        <div class="lp-hero__ctas">
          <Button href="/admissions/visit" variant="primary">Book a tour</Button>
          <a href="/about/leadership#ileana-vranceanu" class="lp-hero__link">Read the founder's letter →</a>
        </div>
      </div>

      <div class="lp-hero__collage">
        <figure class="lp-hero__photo lp-hero__photo--main">
          <img src="/images/scenes/assembly-wave.jpg" alt="FRAM children at a school-wide event in the campus courtyard" loading="eager" decoding="async" fetchpriority="high" />
        </figure>
        <figure class="lp-hero__photo lp-hero__photo--top">
          <img src="/images/houses-photos/dog.jpg" alt="Habermann Campus on a busy school event afternoon" loading="eager" decoding="async" />
        </figure>
        <figure class="lp-hero__photo lp-hero__photo--bot">
          <img src="/images/scenes/bike-club-portrait.jpg" alt="FRAM children with bicycles, lined up at a school activity" loading="lazy" decoding="async" />
        </figure>
      </div>
    </div>
  </section>

  {/* ──────────── 2. EDITORIAL INTRO STATEMENT ──────────── */}
  <section class="lp-intro">
    <div class="container lp-intro__inner">
      <p class="lp-intro__statement">
        <em>Twenty teachers</em>, who know every child by name. <em>Two languages</em>, English and Romanian, taught alongside each other from kindergarten. <em>Three pillars</em>: Academic, Welfare and Pastoral, Skills and Events. <em>Four Houses</em>, named after explorers. <em>Seven values</em>, lived daily. <em>One small school</em>, in central Sibiu.
      </p>
    </div>
  </section>

  {/* ──────────── 3. FOUNDER ──────────── */}
  <section class="lp-founder">
    <div class="container lp-founder__inner">
      <figure class="lp-founder__portrait">
        <img src="/images/leaders/ileana-vranceanu.jpg" alt="Ileana Vrânceanu, founder and CEO of FRAM School" loading="lazy" decoding="async" />
        <figcaption>Ileana Vrânceanu, Founder &amp; CEO.</figcaption>
      </figure>
      <div class="lp-founder__copy">
        <p class="eyebrow">A letter from our founder</p>
        <blockquote class="lp-founder__quote">
          <em>FRAM was born from a simple question: <strong>what kind of school would I want for my own child?</strong></em>
        </blockquote>
        <p class="lp-founder__answer">
          The answer was not only about strong academics, but about character, wellbeing and joy. A community where learning is rigorous but never cold, where values are lived rather than printed on a wall, and where every child feels that they truly belong.
        </p>
        <div class="lp-founder__sign">
          <span class="lp-founder__seal" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="8" r="3" />
              <circle cx="23" cy="8" r="3" />
              <ellipse cx="16" cy="16" rx="9" ry="8" />
              <circle cx="12.5" cy="14" r="0.9" fill="currentColor" />
              <circle cx="19.5" cy="14" r="0.9" fill="currentColor" />
              <path d="M14.5 17.5 q1.5 2 1.5 2 q0 0 1.5 -2" />
              <path d="M13 20 q3 2 6 0" />
            </svg>
          </span>
          <a href="/about/leadership#ileana-vranceanu" class="lp-founder__link">Read the full letter →</a>
        </div>
      </div>
    </div>
  </section>

  {/* ──────────── 4. THREE PILLARS ──────────── */}
  <PillarsTeaser />

  {/* ──────────── 5. YEAR IN PICTURES ──────────── */}
  <section class="lp-year">
    <div class="container">
      <header class="lp-year__head">
        <p class="eyebrow">A year at FRAM</p>
        <h2 class="lp-year__title">In pictures, not pitches.</h2>
        <p class="lp-year__lead">Eight glances at the school: assemblies, classrooms, the campus dog, World Book Day, kids on bikes. Every photo here is from this academic year.</p>
      </header>

      <div class="lp-year__grid">
        <a href="/curriculum/houses" class="lp-tile lp-tile--a" aria-label="Read about the FRAM House System">
          <img src="/images/houses-photos/joy.jpg" alt="FRAM children at an outdoor school activity" loading="lazy" decoding="async" />
          <figcaption>A whole-school activity in the courtyard.</figcaption>
        </a>
        <a href="/about/campus" class="lp-tile lp-tile--b" aria-label="See the Habermann Campus">
          <img src="/images/campus/whole-school.jpg" alt="Habermann Learning Campus on a school event afternoon" loading="lazy" decoding="async" />
          <figcaption>Habermann Campus, on event day.</figcaption>
        </a>
        <a href="/curriculum/clubs" class="lp-tile lp-tile--c" aria-label="See the clubs and events">
          <img src="/images/scenes/bike-club-group.jpg" alt="FRAM children with bicycles at a school activity" loading="lazy" decoding="async" />
          <figcaption>Bike Club, Tuesday afternoon.</figcaption>
        </a>
        <a href="/curriculum/houses" class="lp-tile lp-tile--d" aria-label="Read about the Houses">
          <img src="/images/houses-photos/dog-watching.jpg" alt="A school gathering at the Habermann Campus" loading="lazy" decoding="async" />
          <figcaption>An afternoon gathering at the campus.</figcaption>
        </a>
        <a href="/curriculum/clubs" class="lp-tile lp-tile--e" aria-label="See clubs and events">
          <img src="/images/events/reading-day-2.jpg" alt="A FRAM lesson at the interactive whiteboard" loading="lazy" decoding="async" />
          <figcaption>An English lesson, on the screen.</figcaption>
        </a>
        <a href="/curriculum/welfare-pastoral#behaviour" class="lp-tile lp-tile--f" aria-label="Read about FRAM's approach to behaviour">
          <img src="/images/scenes/kindness-ambassador.jpg" alt="Painted kindness rocks laid out at the campus" loading="lazy" decoding="async" />
          <figcaption>Kindness Alley: a kind word on every stone.</figcaption>
        </a>
        <a href="/curriculum/welfare-pastoral" class="lp-tile lp-tile--g" aria-label="Read about the Welfare and Pastoral Pillar">
          <img src="/images/scenes/world-book-cutout.jpg" alt="A storybook lesson on the classroom screen" loading="lazy" decoding="async" />
          <figcaption>Storytime, on the big screen.</figcaption>
        </a>
        <a href="/curriculum/clubs" class="lp-tile lp-tile--h" aria-label="See clubs and events">
          <img src="/images/scenes/reading-joy.jpg" alt="A child holding sprouting bean plants" loading="lazy" decoding="async" />
          <figcaption>Science, growing beans in cotton.</figcaption>
        </a>
      </div>
    </div>
  </section>

  {/* ──────────── 6. HOUSES TEASER ──────────── */}
  <section class="lp-houses">
    <div class="container">
      <header class="lp-houses__head">
        <p class="eyebrow">Four explorers, one community</p>
        <h2 class="lp-houses__title">The FRAM House System.</h2>
        <p class="lp-houses__lead">Every child is sorted into one of four Houses on day one. The Magic FRAM Moon decides. Each House has its own colour, element, animal and motto. Children stay in their House for their whole time at the school.</p>
      </header>

      <ol class="lp-houses__row">
        <li class="lp-house" style="--h-color: oklch(0.42 0.13 305); --h-ink: oklch(0.97 0.01 305);">
          <span class="lp-house__crest"><img src="/images/houses/tiger.png" alt="" /></span>
          <p class="lp-house__title">House of the Givers</p>
          <h3 class="lp-house__name">Alexandra David-Néel</h3>
          <p class="lp-house__motto">Earth · Tiger · Kindness, Excellence</p>
        </li>
        <li class="lp-house" style="--h-color: oklch(0.55 0.10 200); --h-ink: oklch(0.99 0.005 200);">
          <span class="lp-house__crest"><img src="/images/houses/peacock.png" alt="" /></span>
          <p class="lp-house__title">House of Awareness</p>
          <h3 class="lp-house__name">Fernando Magellan</h3>
          <p class="lp-house__motto">Water · Peacock · Resilience, Awareness</p>
        </li>
        <li class="lp-house" style="--h-color: oklch(0.78 0.14 80); --h-ink: oklch(0.20 0.02 80);">
          <span class="lp-house__crest"><img src="/images/houses/swan.png" alt="" /></span>
          <p class="lp-house__title">House of Courage</p>
          <h3 class="lp-house__name">Amelia Earhart</h3>
          <p class="lp-house__motto">Air · Swan · Courage, Leadership</p>
        </li>
        <li class="lp-house" style="--h-color: oklch(0.55 0.20 350); --h-ink: oklch(0.99 0.005 350);">
          <span class="lp-house__crest"><img src="/images/houses/wolf.png" alt="" /></span>
          <p class="lp-house__title">House of Friendship</p>
          <h3 class="lp-house__name">Neil Armstrong</h3>
          <p class="lp-house__motto">Fire · Wolf · Fairness, Friendship</p>
        </li>
      </ol>

      <p class="lp-houses__cta">
        <a href="/curriculum/houses">Read the full House System →</a>
      </p>
    </div>
  </section>

  {/* ──────────── 7. A DAY ──────────── */}
  <DayInTheLife variant="teaser" />

  {/* ──────────── 8. PEOPLE STRIP ──────────── */}
  <section class="lp-people section--paper-deep">
    <div class="container">
      <header class="lp-people__head">
        <p class="eyebrow">The faces of FRAM</p>
        <h2 class="lp-people__title">Twenty-seven people, every child known by name.</h2>
        <p class="lp-people__lead">FRAM has seven senior leaders and twenty teachers. They are not job titles; they are the school. Each links to their full profile.</p>
      </header>

      <div class="lp-people__strip">
        {leaders.slice(0, 4).map((l) => (
          <a href="/about/leadership" class="lp-person">
            <img src={l.data.portrait} alt={`Portrait of ${l.data.name}`} loading="lazy" decoding="async" />
            <span class="lp-person__caption">
              <strong>{l.data.name}</strong>
              <em>{l.data.role}</em>
            </span>
          </a>
        ))}
        {teachers.map((t) => (
          <a href="/about/teachers" class="lp-person">
            <img src={t.data.portrait!} alt={`Portrait of ${t.data.name}`} loading="lazy" decoding="async" />
            <span class="lp-person__caption">
              <strong>{t.data.name}</strong>
              <em>{t.data.role}</em>
            </span>
          </a>
        ))}
      </div>

      <p class="lp-people__cta">
        <a href="/about/leadership">Meet the seven senior leaders →</a>
        <span aria-hidden="true">·</span>
        <a href="/about/teachers">Meet all twenty teachers →</a>
      </p>
    </div>
  </section>

  {/* ──────────── 9. VOICES ──────────── */}
  <Voices />

  {/* ──────────── 10. CTA CLOSE ──────────── */}
  <CtaBand
    eyebrow="Visit FRAM"
    title="The honest way to know whether FRAM fits is to walk through it on a Tuesday."
    body="Tours run on most weeks during term. We keep them small. The Headmaster meets you at the gate."
    primaryCta={{ label: 'Book a tour', href: '/admissions/visit' }}
    secondaryCta={{ label: 'Or write to admissions', href: 'mailto:admissions@framschool.com' }}
  />
</Layout>

<style>
  /* ──────── 1. HERO ──────── */
  .lp-hero {
    padding-block: clamp(2.5rem, 4vw + 1rem, 5rem) clamp(2.5rem, 4vw + 1rem, 5rem);
    overflow: hidden;
    position: relative;
  }
  .lp-hero__inner {
    display: grid;
    gap: clamp(2rem, 4vw + 1rem, 4rem);
    align-items: center;
  }
  @media (min-width: 980px) {
    .lp-hero__inner { grid-template-columns: 1fr 1fr; gap: 4rem; }
  }

  .lp-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--brand-red);
    margin: 0 0 1.5rem 0;
  }
  .lp-hero__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(2.75rem, 1.6rem + 5.5vw, 5.25rem);
    line-height: 1.04;
    letter-spacing: -0.018em;
    color: var(--ink);
    text-wrap: balance;
    margin: 0;
    font-variation-settings: 'opsz' 144, 'SOFT' 100;
  }
  .lp-hero__sub {
    margin-top: 1.5rem;
    font-size: var(--t-body-lg);
    line-height: 1.55;
    color: var(--ink);
    max-width: 38ch;
  }
  .lp-hero__ctas {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.5rem;
  }
  .lp-hero__link {
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.125rem;
    transition: color var(--t-fast) var(--ease-out-quart);
  }
  .lp-hero__link:hover { color: var(--brand-red); }

  /* Photo collage */
  .lp-hero__collage {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 0.75rem;
    aspect-ratio: 1 / 1;
    max-width: 36rem;
    justify-self: end;
    width: 100%;
  }
  .lp-hero__photo {
    margin: 0;
    overflow: hidden;
    border-radius: 4px;
    background: var(--paper-deep);
    position: relative;
  }
  .lp-hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1200ms var(--ease-out-quart);
  }
  .lp-hero__photo:hover img { transform: scale(1.03); }
  .lp-hero__photo--main { grid-row: 1 / 3; }
  .lp-hero__photo--top { grid-column: 2; grid-row: 1; }
  .lp-hero__photo--bot { grid-column: 2; grid-row: 2; }

  /* ──────── 2. INTRO STATEMENT ──────── */
  .lp-intro {
    padding-block: clamp(3rem, 6vw + 2rem, 6rem);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .lp-intro__inner { max-width: var(--container-reading); }
  .lp-intro__statement {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.375rem, 1.1rem + 1.4vw, 1.875rem);
    line-height: 1.45;
    color: var(--ink);
    letter-spacing: -0.005em;
    margin: 0;
  }
  .lp-intro__statement em {
    font-style: italic;
    color: var(--brand-red);
    font-weight: 500;
  }

  /* ──────── 3. FOUNDER ──────── */
  .lp-founder { padding-block: clamp(3rem, 6vw + 2rem, 7rem); }
  .lp-founder__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }
  @media (min-width: 880px) {
    .lp-founder__inner { grid-template-columns: 0.85fr 1.15fr; gap: 4rem; align-items: center; }
  }
  .lp-founder__portrait {
    margin: 0;
    max-width: 26rem;
    justify-self: center;
  }
  .lp-founder__portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 4px;
    display: block;
    background: var(--paper-deep);
  }
  .lp-founder__portrait figcaption {
    margin-top: 0.625rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
  .lp-founder__copy { max-width: 46rem; }
  .lp-founder__quote {
    margin: 0.875rem 0 1.5rem 0;
    padding: 0;
    border: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 1rem + 2.5vw, 2.25rem);
    line-height: 1.18;
    color: var(--ink);
    letter-spacing: -0.012em;
  }
  .lp-founder__quote em { font-style: italic; }
  .lp-founder__quote strong { color: var(--brand-red); font-weight: 500; }
  .lp-founder__answer {
    font-size: var(--t-body-lg);
    line-height: 1.6;
    color: var(--ink);
    margin-bottom: 1.25rem;
    max-width: 56ch;
  }
  .lp-founder__sign {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
  }
  .lp-founder__seal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    color: var(--brand-red);
    transform: rotate(-6deg);
    transition: transform var(--t-base) var(--ease-out-quart), color var(--t-fast) var(--ease-out-quart);
  }
  .lp-founder__seal svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .lp-founder__sign:hover .lp-founder__seal {
    transform: rotate(2deg);
    color: var(--brand-red-deep);
  }
  @media (prefers-reduced-motion: reduce) {
    .lp-founder__seal { transform: none; }
    .lp-founder__sign:hover .lp-founder__seal { transform: none; }
  }
  .lp-founder__link {
    color: var(--brand-red);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .lp-founder__link:hover { color: var(--brand-red-deep); }

  /* ──────── 5. YEAR IN PICTURES (bento mosaic) ──────── */
  .lp-year { padding-block: clamp(3rem, 6vw + 2rem, 7rem); }
  .lp-year__head { margin-bottom: 3rem; max-width: 46rem; }
  .lp-year__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 1.4rem + 2.8vw, 3rem);
    letter-spacing: -0.012em;
    line-height: 1.08;
    margin: 0.5rem 0 0.875rem;
  }
  .lp-year__lead {
    font-size: var(--t-body-lg);
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 60ch;
    margin: 0;
  }

  .lp-year__grid {
    display: grid;
    gap: 0.625rem;
    grid-template-columns: repeat(2, 1fr);
    grid-template-areas:
      "a a"
      "b b"
      "c d"
      "e f"
      "g h";
  }
  .lp-tile { aspect-ratio: 4 / 3; }
  .lp-tile--a { aspect-ratio: 16 / 11; grid-area: a; }
  .lp-tile--b { aspect-ratio: 16 / 9; grid-area: b; }
  .lp-tile--c { grid-area: c; }
  .lp-tile--d { grid-area: d; }
  .lp-tile--e { grid-area: e; }
  .lp-tile--f { grid-area: f; }
  .lp-tile--g { grid-area: g; }
  .lp-tile--h { grid-area: h; }

  @media (min-width: 720px) {
    .lp-year__grid {
      grid-template-columns: repeat(4, 1fr);
      grid-template-areas:
        "a a b b"
        "a a c d"
        "e f c d"
        "e f g h";
      grid-auto-rows: minmax(180px, auto);
      gap: 1rem;
    }
    /* Reset aspect-ratios for the area-driven desktop layout */
    .lp-tile,
    .lp-tile--a,
    .lp-tile--b { aspect-ratio: auto; }
  }

  .lp-tile {
    margin: 0;
    overflow: hidden;
    border-radius: 4px;
    background: var(--paper-deep);
    position: relative;
    text-decoration: none;
    display: block;
    color: var(--ink);
    cursor: pointer;
  }
  .lp-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 800ms var(--ease-out-quart);
  }
  .lp-tile:hover img { transform: scale(1.04); }
  .lp-tile figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1rem 1rem 0.875rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.875rem;
    color: var(--paper-pure);
    background: linear-gradient(to top, oklch(0.22 0.012 50 / 0.85) 0%, oklch(0.22 0.012 50 / 0.5) 70%, transparent 100%);
    line-height: 1.35;
    transition: opacity var(--t-base) var(--ease-out-quart),
                transform var(--t-base) var(--ease-out-quart);
  }
  /* Captions visible by default on touch devices (no hover available). */
  /* Desktop / hover-capable: hide caption, reveal on hover. */
  @media (hover: hover) and (pointer: fine) {
    .lp-tile figcaption {
      opacity: 0;
      transform: translateY(4px);
    }
    .lp-tile:hover figcaption,
    .lp-tile:focus-visible figcaption {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ──────── 6. HOUSES TEASER ──────── */
  .lp-houses {
