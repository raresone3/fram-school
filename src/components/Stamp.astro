---
/**
 * The FRAM signature stamp, a hand-drawn cross-hatch motif
 * referencing Saxon-Transylvanian textile patterns. Used sparingly
 * across the site as a section marker (footer divider, hero accent,
 * values divider, etc.).
 *
 * Inherits color from `currentColor`. The SVG is intentionally rough
 * (slight irregularities) so it reads as hand-stamped, not vector-perfect.
 */
interface Props {
  size?: number;
  class?: string;
  rotate?: number;
}
const { size = 32, class: className = '', rotate = 0 } = Astro.props;
---

<svg
  viewBox="0 0 64 64"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width="1.6"
  class={`stamp ${className}`.trim()}
  style={rotate ? `transform: rotate(${rotate}deg);` : ''}
  aria-hidden="true"
>
  {/* Outer diamond, slightly irregular */}
  <path d="M32 4 L60 32 L32 60 L4 32 Z" />

  {/* Inner cross-hatch */}
  <path d="M14 32 L50 32" />
  <path d="M32 14 L32 50" />

  {/* Four small accent dots */}
  <circle cx="32" cy="11" r="0.8" fill="currentColor" />
  <circle cx="53" cy="32" r="0.8" fill="currentColor" />
  <circle cx="32" cy="53" r="0.8" fill="currentColor" />
  <circle cx="11" cy="32" r="0.8" fill="currentColor" />
</svg>

<style>
  .stamp {
    display: inline-block;
    flex-shrink: 0;
    color: var(--brand-red);
    opacity: 0.8;
  }
</style>
