---
interface Props {
  size?: 'reading' | 'wide';
}
const { size = 'reading' } = Astro.props;
---

<div class={`prose prose--${size}`}>
  <slot />
</div>

<style>
  .prose {
    font-size: var(--t-body);
    line-height: 1.65;
    color: var(--ink);
  }

  .prose--reading {
    max-width: var(--container-reading);
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
  }
  .prose :global(p:last-child) { margin-bottom: 0; }

  .prose :global(p.lead) {
    font-size: var(--t-body-lg);
    line-height: 1.55;
    margin-bottom: 1.75rem;
    color: var(--ink);
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2rem);
    line-height: 1.2;
    margin-top: 3rem;
    margin-bottom: 1rem;
    letter-spacing: -0.005em;
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.25rem;
    line-height: 1.3;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose :global(a) {
    color: var(--brand-red);
    text-decoration-color: color-mix(in oklch, var(--brand-red) 50%, transparent);
  }
  .prose :global(a:hover) {
    color: var(--brand-red-deep);
    text-decoration-color: var(--brand-red-deep);
  }

  .prose :global(ul), .prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(blockquote) {
    margin: 2.5rem 0;
    padding: 1.25rem 0 1.25rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--t-body-lg);
    line-height: 1.5;
    color: var(--ink);
  }
  .prose :global(blockquote p) {
    margin: 0;
    text-indent: 1.5em;
    position: relative;
  }
  .prose :global(blockquote p:first-of-type::before) {
    content: '"';
    position: absolute;
    left: 0;
    top: -0.3em;
    color: var(--brand-red);
    font-size: 1.5em;
    line-height: 1;
  }
  .prose :global(blockquote cite) {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-body);
    font-style: normal;
    font-size: 0.8125rem;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .prose :global(strong) { font-weight: 600; }
  .prose :global(em) { font-style: italic; }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 3rem 0;
  }
</style>
