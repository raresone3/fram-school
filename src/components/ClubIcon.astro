---
/** Hand-drawn club icons. Stroke-only, inherit color via currentColor. */
type ClubIconType =
  'japanese' | 'choir' | 'crafts' | 'graffiti' | 'painting' | 'coding' |
  'electronics' | 'dance' | 'kinetics' | 'ski' | 'lego' | 'outdoors';

interface Props {
  type: ClubIconType;
  size?: number;
  class?: string;
}

const { type, size = 28, class: className = '' } = Astro.props;
---

<svg
  class={`club-icon club-icon--${type} ${className}`.trim()}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {type === 'japanese' && (
    <g>
      {/* Torii gate: top crossbar curves up, second bar straight, two pillars */}
      <path d="M3 5 q9 -1.5 18 0" />
      <path d="M4 8 H20" />
      <path d="M7 5 V21" />
      <path d="M17 5 V21" />
    </g>
  )}

  {type === 'choir' && (
    <g>
      {/* Eighth note: stem + flag + note head */}
      <path d="M9 17 a2.5 2.5 0 1 0 2.5 2.5 V5" />
      <path d="M11.5 5 q5 1 5 5" />
    </g>
  )}

  {type === 'crafts' && (
    <g>
      {/* Open scissors */}
      <circle cx="6" cy="7" r="2.2" />
      <circle cx="6" cy="17" r="2.2" />
      <path d="M8 8.4 L20 16" />
      <path d="M8 15.6 L20 8" />
      <path d="M14.4 12 L20 12" />
    </g>
  )}

  {type === 'graffiti' && (
    <g>
      {/* Spray can with mist */}
      <path d="M8 9 H16 V20 a1 1 0 0 1 -1 1 H9 a1 1 0 0 1 -1 -1 Z" />
      <path d="M10 9 V6 H14 V9" />
      <path d="M11 4 H13" />
      {/* Mist dots */}
      <path d="M3 6 h0.5" />
      <path d="M4 9 h0.5" />
      <path d="M2.5 11 h0.5" />
      <path d="M5 13 h0.5" />
      <path d="M3 4 h0.5" />
    </g>
  )}

  {type === 'painting' && (
    <g>
      {/* Paintbrush with bristle tip + drop */}
      <path d="M5 19 L13 11" />
      <path d="M14 10 L19 5 a1.4 1.4 0 0 1 2 2 L16 12" />
      <path d="M11 13 L13 15" />
      <path d="M5 19 q-2 0 -2 2 q2 0 2 -2" />
      <path d="M8 5 q1 1.5 0 3 q-1 -1.5 0 -3" />
    </g>
  )}

  {type === 'coding' && (
    <g>
      {/* Chevrons + slash */}
      <path d="M8 7 L3 12 L8 17" />
      <path d="M16 7 L21 12 L16 17" />
      <path d="M14 5 L10 19" />
    </g>
  )}

  {type === 'electronics' && (
    <g>
      {/* Lightning + circuit dot */}
      <path d="M13 2 L7 13 H11 L10 22 L17 11 H13 Z" />
      <circle cx="20" cy="20" r="0.8" fill="currentColor" />
      <circle cx="4" cy="4" r="0.8" fill="currentColor" />
    </g>
  )}

  {type === 'dance' && (
    <g>
      {/* Mid-stride figure + motion swoosh */}
      <circle cx="14" cy="5" r="1.6" />
      <path d="M14 7 L11 13 L7 17" />
      <path d="M11 13 L17 14" />
      <path d="M11 13 L13 21" />
      <path d="M3 19 q4 -2 7 -1" />
    </g>
  )}

  {type === 'kinetics' && (
    <g>
      {/* Two interlocking gears, simplified */}
      <circle cx="9" cy="9" r="3.2" />
      <path d="M9 5 V3 M9 15 V13 M5 9 H3 M15 9 H13 M6.2 6.2 L4.8 4.8 M11.8 11.8 L13.2 13.2 M6.2 11.8 L4.8 13.2 M11.8 6.2 L13.2 4.8" />
      <circle cx="16" cy="16" r="2.4" />
      <path d="M16 13 V11.5 M16 20.5 V19 M13 16 H11.5 M20.5 16 H19" />
    </g>
  )}

  {type === 'ski' && (
    <g>
      {/* Crossed skis with star/snowflake */}
      <path d="M5 4 L19 20" />
      <path d="M19 4 L5 20" />
      <path d="M5 4 L7 4" />
      <path d="M17 4 L19 4" />
      <path d="M5 20 L7 20" />
      <path d="M17 20 L19 20" />
      {/* Tiny snowflake top middle */}
      <path d="M12 1.5 V4" />
      <path d="M11 2.5 L13 2.5" />
    </g>
  )}

  {type === 'lego' && (
    <g>
      {/* 2x2 brick: rectangle + 4 studs on top */}
      <path d="M5 9 H19 V20 H5 Z" />
      <circle cx="9" cy="7" r="1.4" />
      <circle cx="15" cy="7" r="1.4" />
      <path d="M5 13.5 H19" />
    </g>
  )}

  {type === 'outdoors' && (
    <g>
      {/* Pine tree + sun */}
      <path d="M12 4 L7 11 H10 L6 17 H18 L14 11 H17 Z" />
      <path d="M12 17 V21" />
      <circle cx="20" cy="5" r="1.6" />
      <path d="M20 1.5 V2.5 M20 7.5 V8.5 M16.5 5 H17.5 M22.5 5 H23.5" />
    </g>
  )}
</svg>

<style>
  .club-icon {
    display: block;
    flex-shrink: 0;
  }
</style>
