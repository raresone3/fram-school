---
import '~/styles/global.css';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { SITE } from '~/lib/site';

interface Props {
  title: string;
  description?: string;
  current?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noIndex?: boolean;
  /** Pass extra JSON-LD entities specific to this page (BreadcrumbList, Article, etc.) */
  schema?: object | object[];
}

const {
  title,
  description = 'FRAM School is a Cambridge primary school and kindergarten in Sibiu, Romania, for children aged 3 to 11.',
  current = '',
  ogImage = '/images/hero/home.jpg',
  ogType = 'website',
  noIndex = false,
  schema,
} = Astro.props;

const siteTitle = title.includes('FRAM') ? title : `${title} · FRAM School`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageAbs = new URL(ogImage, Astro.site).toString();

// ──── JSON-LD: site-wide identity (rendered on every page) ──────
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  '@id': `${SITE.url}/#school`,
  name: SITE.name,
  alternateName: SITE.shortName,
  url: SITE.url,
  logo: `${SITE.url}/favicon.svg`,
  image: `${SITE.url}/images/hero/home.jpg`,
  description: 'A Cambridge primary school and kindergarten in Sibiu, Romania, teaching the Cambridge Primary Curriculum alongside the Romanian national line, for children aged 3 to 11.',
  foundingDate: String(SITE.founded),
  slogan: 'A primary school built around how children actually learn.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.line2,
    addressLocality: SITE.address.city,
    addressCountry: 'RO',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 45.795,
    longitude: 24.151,
  },
  telephone: SITE.contact.phone,
  email: SITE.contact.email,
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'admissions',
      email: SITE.contact.admissionsEmail,
      availableLanguage: ['English', 'Romanian'],
    },
    {
      '@type': 'ContactPoint',
      contactType: 'safeguarding',
      email: SITE.contact.safeguardingEmail,
      name: SITE.dsl.name,
    },
    {
      '@type': 'ContactPoint',
      contactType: 'human resources',
      email: SITE.contact.vacanciesEmail,
    },
  ],
  sameAs: [
    'https://www.facebook.com/framschool',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  description,
  inLanguage: 'en-GB',
  publisher: { '@id': `${SITE.url}/#school` },
};

// Combine site-wide + per-page schema
const allSchema: object[] = [orgSchema, websiteSchema];
if (Array.isArray(schema)) allSchema.push(...schema);
else if (schema) allSchema.push(schema);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="format-detection" content="telephone=no" />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="FRAM School" />
    <meta name="keywords" content="FRAM School, primary school Sibiu, Cambridge primary Romania, kindergarten Sibiu, international school Sibiu, Habermann Campus, Cambridge International Curriculum" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:alt" content={`${SITE.name}: ${title}`} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <meta name="theme-color" content="#B62027" />
    <meta name="color-scheme" content="light" />

    {/* Hint to AI agents and crawlers about our llms.txt */}
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />

    {/* JSON-LD structured data */}
    {allSchema.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
    <Nav current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // ──── Scroll-rise animation ────
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px 20% 0px', threshold: 0.05 }
      );
      document.querySelectorAll('.rise').forEach((el) => observer.observe(el));

      // ──── Scroll-progress bar (transform-based, no layout thrash) ────
      const progress = document.querySelector('[data-scroll-progress]') as HTMLElement | null;
      if (progress) {
        const onScroll = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          if (max <= 0) {
            progress.style.transform = 'scaleX(0)';
            return;
          }
          const ratio = Math.min(1, Math.max(0, window.scrollY / max));
          progress.style.transform = `scaleX(${ratio})`;
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
    </script>
  </body>
</html>
