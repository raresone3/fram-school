---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'tertiary' | 'inverse';
  type?: 'button' | 'submit';
  class?: string;
}

const { href, variant = 'primary', type = 'button', class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'button';
const cls = `btn btn--${variant} ${className}`.trim();
---

{href ? (
  <a href={href} class={cls}><slot /></a>
) : (
  <button type={type} class={cls}><slot /></button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.005em;
    line-height: 1;
    padding: 0.875rem 1.625rem;
    border-radius: 4px;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    min-height: 44px;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background var(--t-fast) var(--ease-out-quart),
      color var(--t-fast) var(--ease-out-quart),
      border-color var(--t-fast) var(--ease-out-quart),
      transform var(--t-base) var(--ease-out-quart),
      box-shadow var(--t-base) var(--ease-out-quart);
  }
  .btn:active {
    transform: translateY(0) scale(0.985);
    transition-duration: 80ms;
  }

  .btn--primary {
    background: var(--brand-red);
    color: var(--paper-pure);
  }
  .btn--primary:hover {
    background: var(--brand-red-warm);
    color: var(--paper-pure);
    transform: translateY(-1px);
    box-shadow: var(--shadow-soft);
  }

  .btn--secondary {
    background: transparent;
    color: var(--ink);
    border-color: var(--ink);
  }
  .btn--secondary:hover {
    background: var(--ink);
    color: var(--paper-pure);
  }

  .btn--tertiary {
    background: transparent;
    color: var(--ink);
    padding: 0.5rem 0;
    border-radius: 0;
    font-size: 0.9375rem;
  }
  .btn--tertiary::after {
    content: ' →';
    transition: transform var(--t-fast) var(--ease-out-quart);
    display: inline-block;
  }
  .btn--tertiary:hover {
    color: var(--brand-red);
  }
  .btn--tertiary:hover::after {
    transform: translateX(3px);
  }

  .btn--inverse {
    background: var(--paper-pure);
    color: var(--brand-red);
  }
  .btn--inverse:hover {
    background: var(--paper);
    color: var(--brand-red-deep);
    transform: translateY(-1px);
  }
</style>
