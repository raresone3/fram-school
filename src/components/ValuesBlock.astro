---
import { getCollection } from 'astro:content';

interface Props {
  variant?: 'spread' | 'compact' | 'sticker';
}
const { variant = 'spread' } = Astro.props;

const all = await getCollection('values');
const values = all.sort((a, b) => a.data.order - b.data.order);

// Sticker variant: alternating red/cream, hand-stamped rotations
const stickerRotations = [-1.6, 1.2, -0.8, 1.6, -1.2, 0.8, -1.4];
---

<section class={`values values--${variant}`}>
  <div class="container">
    {variant === 'spread' && (
      <header class="values__head">
        <p class="eyebrow">Our values</p>
        <h2 class="values__title">Seven values, lived daily.</h2>
      </header>
    )}

    {variant === 'sticker' ? (
      <>
        <header class="values__head values__head--sticker">
          <p class="eyebrow">Our values</p>
          <h2 class="values__title">Seven values, lived daily.</h2>
          <p class="values__sub">Each is paired with what we expect it to look like in practice, for a four-year-old, a nine-year-old, an adult.</p>
        </header>
        <ol class="stickers" aria-label="The seven FRAM values">
          {values.map((value, i) => (
            <li
              class={`sticker sticker--${i % 2 === 0 ? 'red' : 'cream'}`}
              style={`--rot: ${stickerRotations[i] ?? 0}deg; --i: ${i};`}
            >
              <span class="sticker__name">{value.data.name}</span>
              <span class="sticker__desc">{value.data.description}</span>
            </li>
          ))}
        </ol>
        <svg class="stickers__wave" viewBox="0 0 1200 80" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 50 Q60 20 120 50 T240 50 T360 50 T480 50 T600 50 T720 50 T840 50 T960 50 T1080 50 T1200 50 V80 H0 Z" fill="currentColor" />
        </svg>
      </>
    ) : (
      <ol class="values__list">
        {values.map((value) => (
          <li class="value rise">
            <div class="value__num" aria-hidden="true">
              {value.data.order.toString().padStart(2, '0')}
            </div>
            <div class="value__body">
              <h3 class="value__name">{value.data.name}</h3>
              <p class="value__desc">{value.data.description}</p>
            </div>
          </li>
        ))}
      </ol>
    )}
  </div>
</section>

<style>
  .values { padding-block: clamp(3rem, 5vw + 1.5rem, 6rem); }

  .values__head { margin-bottom: 3rem; }
  .values__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.75rem, 1.2rem + 2.5vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.005em;
    max-width: 18ch;
  }

  .values__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .value {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem 1.75rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }

  @media (min-width: 720px) {
    .value {
      grid-template-columns: 6rem 1fr;
      gap: 2.5rem 3rem;
      padding-block: 2.25rem;
    }
  }

  .value__num {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
    line-height: 1;
    color: var(--brand-red);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .value__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.375rem, 1rem + 1.4vw, 1.75rem);
    line-height: 1.2;
    margin-bottom: 0.5rem;
    letter-spacing: -0.005em;
  }

  .value__desc {
    font-size: var(--t-body-lg);
    line-height: 1.55;
    color: var(--ink);
    max-width: 60ch;
  }

  .values--compact .values__list { border-top: 0; }
  .values--compact .value {
    border-bottom: 0;
    padding-block: 0.75rem;
  }
  .values--compact .value__num {
    font-size: 1.25rem;
  }
  .values--compact .value__name {
    font-size: 1.125rem;
    margin-bottom: 0;
  }
  .values--compact .value__desc {
    font-size: 1rem;
  }

  /* ──────── Sticker variant: stacked, alternating, hand-stamped ──────── */
  .values--sticker {
    padding-block: clamp(3rem, 6vw + 2rem, 6rem);
  }
  .values__head--sticker {
    max-width: 38rem;
    margin: 0 auto 3rem;
    text-align: center;
  }
  .values__sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--t-body-lg);
    color: var(--ink-muted);
    line-height: 1.55;
    margin: 0.75rem auto 0;
    max-width: 50ch;
  }

  .stickers {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 44rem;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  .sticker {
    --rot: 0deg;
    --shift: 0;
    transform: rotate(var(--rot));
    transform-origin: 50% 50%;
    border-radius: 999px;
    padding: clamp(1.125rem, 1.5vw + 0.5rem, 1.5rem) clamp(1.625rem, 2vw + 1rem, 2.5rem);
    margin-top: -0.875rem;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
    text-align: center;
    box-shadow: 0 4px 16px oklch(0.22 0.012 50 / 0.10);
    display: grid;
    place-items: center;
    gap: 0.5rem;
    transition: transform 220ms var(--ease-out-quart), box-shadow 220ms var(--ease-out-quart);
    will-change: transform;
  }
  .sticker:first-child { margin-top: 0; }

  .sticker--red {
    background: var(--brand-red);
    color: var(--paper-pure);
  }
  .sticker--cream {
    background: var(--ochre-soft);
    color: var(--brand-red-deep);
  }

  .sticker__name {
    font-size: clamp(1.75rem, 1.4rem + 2.4vw, 3rem);
    text-transform: uppercase;
    letter-spacing: -0.005em;
    font-variation-settings: 'opsz' 144, 'SOFT' 100;
  }
  .sticker__desc {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.875rem;
    line-height: 1.4;
    max-width: 42ch;
    opacity: 0.92;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  .sticker:hover {
    transform: rotate(0deg) translateY(-2px);
    box-shadow: 0 10px 28px oklch(0.22 0.012 50 / 0.14);
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .sticker { transform: none !important; transition: none; }
    .sticker:hover { transform: none !important; }
  }

  .stickers__wave {
    display: block;
    width: 100%;
    height: 64px;
    margin-top: 2rem;
    color: var(--brand-red);
    opacity: 0.18;
  }

  @media (max-width: 540px) {
    .sticker {
      border-radius: 28px;
      margin-top: -0.625rem;
    }
    .sticker__desc { display: none; }
  }
</style>
