---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  leader: CollectionEntry<'leaders'>;
}
const { leader } = Astro.props;
const { Content } = await render(leader);
const { name, role, qualifications, portrait, email, isDsl } = leader.data;
---

<article class={`leader rise ${isDsl ? 'leader--dsl' : ''}`}>
  <figure class="leader__portrait">
    {portrait ? (
      <img src={portrait} alt={`Portrait of ${name}`} loading="lazy" decoding="async" />
    ) : (
      <div class="leader__placeholder" aria-hidden="true">
        <span>{name.split(' ').map((n) => n[0]).slice(0, 2).join('')}</span>
      </div>
    )}
  </figure>

  <div class="leader__body">
    <p class="eyebrow leader__role">{role}</p>
    <h2 class="leader__name">{name}</h2>

    {qualifications && qualifications.length > 0 && (
      <ul class="leader__quals">
        {qualifications.map((q) => <li>{q}</li>)}
      </ul>
    )}

    <div class="leader__prose">
      <Content />
    </div>

    {email && isDsl && (
      <aside class="leader__safeguarding">
        <p class="eyebrow">Safeguarding contact</p>
        <p>For any concern about a child at FRAM, write to <a href={`mailto:${email}`}>{email}</a>.</p>
      </aside>
    )}
  </div>
</article>

<style>
  .leader {
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
    grid-template-columns: 1fr;
    padding-block: clamp(2.5rem, 5vw, 5rem);
    border-bottom: 1px solid var(--rule);
  }
  .leader:last-of-type { border-bottom: 0; }

  @media (min-width: 720px) {
    .leader {
      grid-template-columns: 5fr 7fr;
    }
  }

  .leader__portrait {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
    background: var(--paper-deep);
    position: relative;
  }
  .leader__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .leader__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--brand-red-soft), var(--ochre-soft));
    color: var(--brand-red);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: 0.05em;
  }

  .leader__role {
    margin-bottom: 0.5rem;
    color: var(--brand-red);
  }

  .leader__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.875rem, 1.4rem + 1.8vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.005em;
    margin-bottom: 1rem;
  }

  .leader__quals {
    list-style: none;
    margin: 0 0 1.75rem 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .leader__quals li {
    padding: 0.5rem 0;
    font-size: 0.9375rem;
    color: var(--ink-muted);
    border-bottom: 1px solid var(--rule);
  }

  .leader__prose {
    font-size: var(--t-body-lg);
    line-height: 1.6;
    max-width: 60ch;
  }
  .leader__prose :global(p) {
    margin-bottom: 1.25rem;
  }
  .leader__prose :global(p:last-child) { margin-bottom: 0; }
  .leader__prose :global(em) {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--brand-red);
  }

  .leader__safeguarding {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    background: var(--brand-red-soft);
    border-radius: 4px;
    border-left: 0; /* explicit no side-stripe */
    color: var(--brand-red-deep);
  }
  .leader__safeguarding .eyebrow {
    color: var(--brand-red);
    margin-bottom: 0.375rem;
  }
  .leader__safeguarding a { color: var(--brand-red); }
</style>
