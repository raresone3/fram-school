---
import { SITE, NAV } from '~/lib/site';

interface Props {
  current?: string;
}

const { current = '' } = Astro.props;
---

<header class="nav" data-nav>
  <div class="container nav__inner">
    <a href="/" class="nav__brand" aria-label={`${SITE.name}, home`}>
      <span class="nav__wordmark" aria-hidden="true">
        <span class="nav__wordmark-name">FRAM</span>
        <span class="nav__wordmark-tag">SCHOOL</span>
      </span>
      <span class="nav__brand-text-vh">FRAM School</span>
    </a>

    <nav class="nav__primary" aria-label="Primary">
      <ul>
        {NAV.map((item) => {
          const hasChildren = !!item.children;
          const isActive = current === item.href || (item.href !== '/' && current.startsWith(item.href + '/'));
          return (
            <li class={hasChildren ? 'nav__item nav__item--has-children' : 'nav__item'}>
              <a
                href={item.href}
                class="nav__link"
                aria-current={isActive ? 'page' : undefined}
                aria-haspopup={hasChildren ? 'true' : undefined}
                aria-expanded={hasChildren ? 'false' : undefined}
              >
                {item.label}
                {hasChildren && (
                  <span class="nav__chev" aria-hidden="true">
                    <svg width="10" height="6" viewBox="0 0 10 6" fill="none">
                      <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                )}
              </a>
              {hasChildren && (
                <div class="nav__menu" role="menu">
                  <ul>
                    {item.children!.map((child) => {
                      const isPdf = child.href.toLowerCase().endsWith('.pdf');
                      return (
                        <li role="none">
                          <a
                            href={child.href}
                            role="menuitem"
                            class="nav__menu-link"
                            aria-current={current === child.href ? 'page' : undefined}
                          >
                            <span class="nav__menu-label">
                              {child.label}
                              {isPdf && <span class="nav__menu-badge" aria-hidden="true">PDF</span>}
                            </span>
                            {child.description && (
                              <span class="nav__menu-desc">{child.description}</span>
                            )}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="nav__actions">
      <a href="/admissions/visit" class="nav__cta">Book a tour</a>
      <button type="button" class="nav__toggle" aria-label="Open menu" aria-expanded="false" data-nav-toggle>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="nav__drawer" data-nav-drawer hidden>
    <nav aria-label="Mobile">
      <ul>
        {NAV.map((item) => {
          const hasChildren = !!item.children;
          return (
            <li class="nav__drawer-item">
              {hasChildren ? (
                <details>
                  <summary>
                    <span>{item.label}</span>
                    <span class="nav__drawer-chev" aria-hidden="true">+</span>
                  </summary>
                  <ul>
                    {item.children!.map((child) => (
                      <li><a href={child.href}>{child.label}</a></li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a href={item.href}>{item.label}</a>
              )}
            </li>
          );
        })}
        <li class="nav__drawer-cta">
          <a href="/admissions/visit">Book a tour</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklch, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-base) var(--ease-out-quart);
  }
  .nav[data-scrolled='true'] {
    border-bottom-color: var(--rule);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
    line-height: 1;
  }
  .nav__wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .nav__wordmark-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.625rem;
    letter-spacing: -0.015em;
    color: var(--ink);
    font-variation-settings: 'opsz' 144, 'SOFT' 100;
    transition: color var(--t-fast) var(--ease-out-quart);
  }
  .nav__wordmark-tag {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brand-red);
    padding-bottom: 0.0625rem;
    transition: color var(--t-fast) var(--ease-out-quart);
  }
  .nav__brand:hover .nav__wordmark-name {
    color: var(--brand-red-deep);
  }
  .nav__brand:hover .nav__wordmark-tag {
    color: var(--brand-red-deep);
  }
  /* Visually hide the brand label but keep it for screen readers and search engines */
  .nav__brand-text-vh {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nav__primary { display: none; }

  @media (min-width: 980px) {
    .nav__primary { display: block; }
    .nav__primary > ul {
      display: flex;
      gap: 0.25rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .nav__item {
      position: relative;
    }

    .nav__link {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      font-size: 0.9375rem;
      color: var(--ink);
      text-decoration: none;
      padding: 0.625rem 0.875rem;
      border-radius: 3px;
      position: relative;
      transition: color var(--t-fast) var(--ease-out-quart),
                  background var(--t-fast) var(--ease-out-quart);
    }
    .nav__link:hover { color: var(--brand-red); }
    .nav__link[aria-current='page']::after {
      content: '';
      position: absolute;
      left: 0.875rem;
      right: 0.875rem;
      bottom: 0.25rem;
      height: 1px;
      background: var(--brand-red);
    }

    .nav__chev {
      display: inline-flex;
      transition: transform var(--t-fast) var(--ease-out-quart);
      opacity: 0.7;
    }
    .nav__item--has-children:hover .nav__chev,
    .nav__item--has-children:focus-within .nav__chev {
      transform: rotate(180deg);
      opacity: 1;
    }

    .nav__menu {
      position: absolute;
      top: 100%;
      left: 0;
      min-width: 18rem;
      max-width: 22rem;
      background: var(--paper-pure);
      border: 1px solid var(--rule);
      border-radius: 4px;
      box-shadow: var(--shadow-lift);
      padding: 0.5rem;
      opacity: 0;
      transform: translateY(-4px);
      pointer-events: none;
      transition: opacity var(--t-fast) var(--ease-out-quart),
                  transform var(--t-fast) var(--ease-out-quart);
      z-index: 5;
    }
    .nav__item--has-children:hover .nav__menu,
    .nav__item--has-children:focus-within .nav__menu {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .nav__menu ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 1px;
    }

    .nav__menu-link {
      display: block;
      padding: 0.75rem 0.875rem;
      border-radius: 3px;
      text-decoration: none;
      color: var(--ink);
      transition: background var(--t-fast) var(--ease-out-quart),
                  color var(--t-fast) var(--ease-out-quart);
    }
    .nav__menu-link:hover {
      background: var(--brand-red-soft);
      color: var(--brand-red-deep);
    }
    .nav__menu-link[aria-current='page'] {
      background: var(--brand-red-soft);
      color: var(--brand-red-deep);
    }

    .nav__menu-label {
      display: block;
      font-size: 0.9375rem;
      font-weight: 500;
      line-height: 1.3;
      margin-bottom: 0.125rem;
    }
    .nav__menu-badge {
      display: inline-block;
      margin-left: 0.5rem;
      padding: 0.0625rem 0.375rem;
      font-size: 0.625rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      color: var(--brand-red);
      background: var(--brand-red-soft);
      border-radius: 2px;
      vertical-align: 0.05em;
    }
    .nav__menu-desc {
      display: block;
      font-size: 0.8125rem;
      color: var(--ink-muted);
      line-height: 1.4;
    }
    .nav__menu-link:hover .nav__menu-desc,
    .nav__menu-link[aria-current='page'] .nav__menu-desc {
      color: oklch(0.45 0.10 25);
    }
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .nav__cta {
    display: none;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--paper-pure);
    background: var(--brand-red);
    padding: 0.5rem 1rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background var(--t-fast) var(--ease-out-quart);
  }
  .nav__cta:hover { background: var(--brand-red-warm); color: var(--paper-pure); }

  @media (min-width: 720px) {
    .nav__cta { display: inline-flex; align-items: center; }
  }

  .nav__toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 2.25rem;
    height: 2.25rem;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 0.5rem;
  }
  .nav__toggle span {
    display: block;
    height: 1.5px;
    background: var(--ink);
    transition: transform var(--t-base) var(--ease-out-quart),
                opacity var(--t-base) var(--ease-out-quart);
  }
  @media (min-width: 980px) {
    .nav__toggle { display: none; }
  }

  /* ──── Mobile drawer ──── */
  .nav__drawer {
    border-top: 1px solid var(--rule);
    background: var(--paper);
    max-height: calc(100vh - 4.25rem);
    overflow-y: auto;
  }
  .nav__drawer > nav > ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 1rem;
  }
  .nav__drawer-item { padding: 0; }

  .nav__drawer-item > a,
  .nav__drawer-item > details > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem clamp(1.25rem, 2vw + 0.5rem, 2rem);
    font-family: var(--font-display);
    font-size: 1.375rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    cursor: pointer;
    list-style: none;
  }
  .nav__drawer-item > details > summary::-webkit-details-marker { display: none; }
  .nav__drawer-item > a:hover,
  .nav__drawer-item > details > summary:hover { color: var(--brand-red); }

  .nav__drawer-chev {
    font-family: var(--font-body);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--ink-muted);
    transition: transform var(--t-base) var(--ease-out-quart);
  }
  details[open] .nav__drawer-chev { transform: rotate(45deg); color: var(--brand-red); }

  .nav__drawer-item details ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 0.75rem;
    background: var(--paper-deep);
  }
  .nav__drawer-item details ul li a {
    display: block;
    padding: 0.625rem clamp(2.5rem, 3vw + 1.5rem, 3rem);
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--ink);
    text-decoration: none;
  }
  .nav__drawer-item details ul li a:hover {
    color: var(--brand-red);
  }

  .nav__drawer-cta a {
    display: block;
    padding: 0.875rem clamp(1.25rem, 2vw + 0.5rem, 2rem);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.375rem;
    color: var(--brand-red);
    text-decoration: none;
  }

  .nav[data-open='true'] .nav__toggle span:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  .nav[data-open='true'] .nav__toggle span:nth-child(2) {
    opacity: 0;
  }
  .nav[data-open='true'] .nav__toggle span:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }
</style>

<script>
  const nav = document.querySelector('[data-nav]') as HTMLElement | null;
  const toggle = document.querySelector('[data-nav-toggle]') as HTMLButtonElement | null;
  const drawer = document.querySelector('[data-nav-drawer]') as HTMLElement | null;

  if (nav && toggle && drawer) {
    toggle.addEventListener('click', () => {
      const open = nav.getAttribute('data-open') === 'true';
      nav.setAttribute('data-open', String(!open));
      toggle.setAttribute('aria-expanded', String(!open));
      drawer.hidden = open;
    });
  }

  if (nav) {
    const onScroll = () => {
      nav.setAttribute('data-scrolled', String(window.scrollY > 4));
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Desktop dropdowns: keyboard support, arrow down opens, escape closes.
  document.querySelectorAll<HTMLElement>('.nav__item--has-children').forEach((item) => {
    const trigger = item.querySelector<HTMLAnchorElement>('.nav__link');
    if (!trigger) return;

    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        const firstLink = item.querySelector<HTMLAnchorElement>('.nav__menu-link');
        firstLink?.focus();
      }
    });

    item.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        trigger.focus();
      }
    });
  });
</script>
